<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.dsh</groupId>
        <artifactId>dsh-java</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>dsh-app</artifactId>
    <name>dsh-app</name>
    <description>宿主应用: session 日志 / LLM seam / 工具系统 / AgentLoop / REST+SSE</description>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!-- 可执行 jar 加 -exec 后缀, 原始薄 jar 仍是主工件,
                         否则插件模块依赖的 dsh-app 会变成嵌套 BOOT-INF 的 fat jar, 编译期找不到类 -->
                    <classifier>exec</classifier>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
